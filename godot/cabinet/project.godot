; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Lucky5 Cabinet"
run/main_scene="res://scenes/CabinetRoot.tscn"
config/features=PackedStringArray("4.6", "GL Compatibility")
config/icon="res://icon-512.png"

[autoload]

CG="*uid://di2oxtaq5vhmh"

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[dotnet]

project/assembly_name="Lucky5 Cabinet"

[editor_plugins]

enabled=PackedStringArray("res://addons/RHSM/plugin.cfg", "res://addons/godette_agent/plugin.cfg", "res://addons/shader_library/plugin.cfg", "res://addons/simple_cards/plugin.cfg")

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true

[shader_library]

internal/previous_shaders_folder="res://shaders/shaderlib/"
