+    var env_base := OS.get_environment("LUCKY5_API_BASE_URL")
+    if not env_base.is_empty():
+        api_base_url = env_base
+
+    access_token = OS.get_environment("LUCKY5_ACCESS_TOKEN")
+
+    var env_machine := OS.get_environment("LUCKY5_MACHINE_ID")
