# Netlify / hosted Next.js build settings for the Lucky5 web shell.
# Keep NEXT_PUBLIC_API_BASE blank when the site should call the same-origin
# Next.js rewrites, and set LUCKY5_API_ORIGIN to the backend origin they proxy to.

LUCKY5_API_ORIGIN=https://your-lucky5-api.example.com
NEXT_PUBLIC_API_BASE=
